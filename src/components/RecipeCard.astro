---
interface Props {
    lang: string;
    id: string;
    title: string;
    description: string;
    tags: string[];
}

const { lang, id, title, description, tags } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}/${lang}/recipe/${id}`} class="menu-card" data-id={id} data-tags={tags.join(',')}>
    <div class="recipe-title">{title}</div>
    <div class="recipe-desc">{description || 'Authentic traditional workflow.'}</div>
    <div class="card-tags">
        {tags.map(tag => (
            <span class="card-tag-mini">{tag}</span>
        ))}
    </div>
</a>

<style>
    .menu-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 16px;
        box-shadow: 0 1px 2px rgba(43, 26, 15, 0.05);
        display: block;
        text-decoration: none;
        color: inherit;
        transition: transform 0.1s ease;
    }
    .menu-card:active {
        transform: scale(0.99);
    }

    .recipe-title {
        color: var(--primary-color);
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 4px;
    }
    .recipe-desc {
        font-size: 13px;
        color: var(--muted-text);
        line-height: 1.4;
        margin-bottom: 8px;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .card-tag-mini {
        font-size: 10px;
        font-weight: bold;
        background: var(--primary-light);
        color: var(--primary-color);
        padding: 2px 6px;
        border-radius: 4px;
    }

    @media (max-width: 380px) {
        .menu-card {
            padding: 12px;
        }
    }

    @media (pointer: coarse) {
        .menu-card {
            padding: 16px;
        }
    }
</style>
