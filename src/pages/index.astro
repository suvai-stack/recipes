---
// Using a custom blank redirect page so it's completely discrete, 
// avoiding Astro's default "Redirecting to..." text template.
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content="0;url=/recipes/en/">
    <title>Suvai Stack</title>
    <style>
        body { background-color: #fcfaf6; margin: 0; }
        @media (prefers-color-scheme: dark) {
            body { background-color: #1a1512; }
        }
    </style>
</head>
<body>
    <script>
        window.location.replace("/recipes/en/");
    </script>
</body>
</html>
